# ── Server ─────────────────────────────────────────────
PORT=5000
# Frontend origin allowed by CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# ── MySQL ──────────────────────────────────────────────
# Fill these in on the machine that hosts MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=expense_tracker

# ── Auth ───────────────────────────────────────────────
# Use a long, random string in production.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
